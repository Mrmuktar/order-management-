# REQUIRED: your own WhatsApp number, country code included, digits only.
# Example Bangladesh: 8801XXXXXXXXX
ADMIN_NUMBER=8801XXXXXXXXX

# Web panel port (Render provides PORT automatically)
PORT=3000

# Render Persistent Disk mount path. Set a disk at this exact path in Render.
DATA_DIR=/var/data

# Optional protection for the browser pairing/status page
DASHBOARD_PASSWORD=change-this-long-password

# Steadfast API credentials (keep private; never upload real keys to GitHub)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1

# Optional: use a different Node logger level
LOG_LEVEL=info
